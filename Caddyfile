:8080 {
  basic_auth {
    {$STAMMBAUM_USER} {$STAMMBAUM_PASSWORD_HASH}
  }

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
  }

  @appShell path / /index.html /sw.js /manifest.webmanifest
  header @appShell Cache-Control "private, no-cache, no-store, must-revalidate"

  @assets path /assets/* /app-icon.svg
  header @assets Cache-Control "private, max-age=31536000, immutable"

  root * /srv
  encode zstd gzip
  try_files {path} /index.html
  file_server
}
